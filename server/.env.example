NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database configuration (PostgreSQL 16/18 or Supabase)
# Option A: Menggunakan DATABASE_URL (Rekomendasi untuk Supabase / Cloud)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Option B: Menggunakan parameter terpisah
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=epres_db
DB_SSL=false
# Set DB_SSL=true jika menggunakan PostgreSQL cloud (seperti Supabase) tanpa DATABASE_URL

# JWT Secrets (use high entropy strings in production)
JWT_ACCESS_SECRET=epres_super_secret_access_jwt_key_2026_wib_secure
JWT_REFRESH_SECRET=epres_super_secret_refresh_jwt_key_2026_wib_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application Settings
TIMEZONE=Asia/Jakarta
