NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database configuration (PostgreSQL 16/18)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
